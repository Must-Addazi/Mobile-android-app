<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reservationItemLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Reservation ID -->
    <TextView
        android:id="@+id/reservationId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ID: 12345"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Reservation Date -->
    <TextView
        android:id="@+id/reservationDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Reservation Date: 01 Jan 2025"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/reservationId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Reservation Status -->
    <TextView
        android:id="@+id/reservationStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Status: Confirmed"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/reservationDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>